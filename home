  <style>
    body { font-family: 'Nunito', sans-serif; color: #4A2430; }
    h1, h2, h3, .font-titulo { font-family: 'Poppins', sans-serif; }
    /* Formato hexagonal (favo de mel) usado nos ícones */
    .hex { clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
    /* Revelação suave ao rolar */
    .reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
    .reveal.show { opacity: 1; transform: none; }
    /* Botões: contorno branco + sombra cacau, como o logo em formato de adesivo */
    .btn { --sh: 5px; display: inline-flex; align-items: center; justify-content: center; gap: .6rem; text-align: center; font-family: 'Poppins', sans-serif; font-weight: 600; border: 3px solid #fff; border-radius: 9999px; box-shadow: 0 var(--sh) 0 #4A2430; transition: transform .15s ease, box-shadow .15s ease; }
