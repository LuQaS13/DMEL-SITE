    .btn:active { transform: translateY(calc(var(--sh) - 1px)); box-shadow: 0 1px 0 #4A2430; }
    .btn-mel { background: #FBB117; color: #4A2430; } .btn-pink { background: #FF69B4; color: #4A2430; }
    .btn-menta { background: #C0F5E3; color: #4A2430; } .btn-white { background: #fff; color: #4A2430; }
    /* Animações do topo */
    @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
    @keyframes pop { from { opacity: 0; transform: scale(.85) rotate(-4deg); } to { opacity: 1; transform: none; } }
    @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
    @keyframes drift { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-18px) rotate(18deg); } }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes marquee { to { transform: translateX(-50%); } }
    .rise { opacity: 0; animation: rise .8s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: var(--d, 0s); }
    .hero-visual { animation: pop .9s cubic-bezier(.2,.7,.2,1) .3s both, floaty 6s ease-in-out 1.3s infinite; }
    .drift { animation: drift 8s ease-in-out infinite; } .d2 { animation-duration: 11s; animation-delay: -3s; } .d3 { animation-duration: 9s; animation-delay: -5s; }
    .spin-slow { animation: spin 18s linear infinite; }
    .marquee-track { animation: marquee 30s linear infinite; } .marquee:hover .marquee-track { animation-play-state: paused; }
    h1.font-hero { font-family: 'Quicksand', 'Poppins', sans-serif; font-weight: 700; }
    /* Marca-texto suave no título */
    @keyframes hl { to { background-size: 100% 100%; } }
    .hl { padding: 0 .08em; background: linear-gradient(transparent 62%, #FFF3B0 62%) no-repeat 0 0 / 0% 100%; animation: hl .9s ease .9s forwards; }
    /* Computador: selo parado (gira só ao passar o mouse) */
    @media (min-width: 1024px) {
      .spin-slow { animation: none; }
      .hero-visual:hover .spin-slow { animation: spin 10s linear infinite; }
    }
    :focus-visible { outline: 3px solid #4A2430; outline-offset: 3px; }
    @media (prefers-reduced-motion: reduce) {
      .btn, .btn:hover, .btn:active { transition: none; transform: none; } .rise, .hero-visual, .drift, .spin-slow, .marquee-track { animation: none !important; opacity: 1 !important; } .hl { animation: none; background-size: 100% 100%; } .reveal { opacity: 1; transform: none; transition: none; }
